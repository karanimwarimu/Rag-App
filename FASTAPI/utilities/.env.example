# Hugging Face Inference API keys (serverless embeddings + reranking)
Embedding_KEY=
reranker_KEY=

# LLM provider keys (used by litellm for answer generation)
GOOGLE_API_KEY=
HUGGINGFACE_API_KEY=

# CORS: comma-separated list of allowed frontend origins.
# Vite dev server defaults to http://localhost:5173.
FRONTEND_ORIGIN=http://localhost:5173
